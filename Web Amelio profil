<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F1F4F7;--ink:#0F1B2D;--muted:#566275;--line:#D5DCE4;--accent:#0F766E;--soft:#D6EEEA;--side:#0F1B2D;--glow:#5EEAD4;
--display:"Bricolage Grotesque",system-ui,sans-serif;--body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 var(--body)}
a{color:var(--accent)}
a:focus-visible{outline:3px solid var(--glow);outline-offset:3px}
.layout{display:grid;grid-template-columns:320px 1fr;min-height:100vh}
.side{position:sticky;top:0;height:100vh;padding:3rem 2rem;background:var(--side);color:#E8EEF5;display:flex;flex-direction:column;gap:.5rem}
.avatar{width:112px;height:112px;border-radius:50%;object-fit:cover;display:grid;place-items:center;background:var(--glow);color:var(--side);font:700 2.5rem var(--display);margin-bottom:1rem}
.side h1{margin:0;font:700 2.25rem/1.1 var(--display);letter-spacing:-.02em}
.peran{margin:0 0 2rem;color:#A9B6C6}
.side nav{display:flex;flex-direction:column;gap:.25rem}
.side nav a{color:#E8EEF5;text-decoration:none;padding:.5rem 0 .5rem 1rem;border-left:3px solid transparent}
.side nav a:hover{border-left-color:#3B4A60}
.side nav a.aktif{border-left-color:var(--glow);color:var(--glow);font-weight:600}
main{padding:3rem clamp(1.25rem,5vw,4rem);max-width:52rem}
section{padding:2rem 0 3rem;scroll-margin-top:1rem}
section+section{border-top:1px solid var(--line)}
h2{margin:0 0 1.25rem;font:700 2rem/1.15 var(--display);letter-spacing:-.01em}
h3{margin:2rem 0 .75rem;font:600 1.1rem var(--body)}
.pengantar{max-width:62ch}
.catatan{color:var(--muted);font-size:.95rem}
code{background:var(--soft);padding:.1rem .35rem;border-radius:4px}
.data{margin:1.5rem 0 0;display:grid;gap:.75rem}
.data div,.skill li,.kontak li{display:grid;grid-template-columns:11rem 1fr;gap:1rem}
.data div{padding-bottom:.75rem;border-bottom:1px solid var(--line)}
.data dt,.kontak span{color:var(--muted)}
.data dd{margin:0;font-weight:500}
.skill{list-style:none;margin:0;padding:0;display:grid;gap:.9rem}
.skill li{align-items:center}
.meter{height:10px;background:linear-gradient(90deg,var(--accent) calc(var(--lv)*20%),var(--line) 0);
-webkit-mask:repeating-linear-gradient(90deg,#000 0 calc(20% - 4px),transparent calc(20% - 4px) 20%);
mask:repeating-linear-gradient(90deg,#000 0 calc(20% - 4px),transparent calc(20% - 4px) 20%)}
.waktu{list-style:none;margin:0;padding:0 0 0 1.75rem;border-left:2px solid var(--line)}
.waktu li{position:relative;padding-bottom:2rem}
.waktu li::before{content:"";position:absolute;left:calc(-1.75rem - 7px);top:.4rem;width:12px;height:12px;border-radius:50%;background:var(--accent);border:2px solid var(--bg);box-sizing:content-box}
.waktu time{color:var(--accent);font-weight:600}
.waktu h3{margin:.15rem 0 .35rem;font-size:1.2rem}
.waktu p{margin:0 0 .5rem;max-width:60ch}
.label{display:inline-block;padding:.1rem .65rem;border-radius:999px;background:var(--soft);color:var(--accent);font-size:.85rem;font-weight:500}
.kontak{list-style:none;margin:1.5rem 0;padding:0}
.kontak li{grid-template-columns:8rem 1fr;padding:.75rem 0;border-bottom:1px solid var(--line)}
.tombol{display:inline-block;padding:.75rem 1.5rem;background:var(--accent);color:#fff;text-decoration:none;font-weight:600;border-radius:8px}
.tombol:hover{background:#0B5A54}
footer{padding:1.5rem;text-align:center;color:var(--muted);font-size:.9rem;border-top:1px solid var(--line)}
footer p{margin:0}
@media(max-width:860px){
.layout{grid-template-columns:1fr}
.side{position:static;height:auto;padding:2rem 1.25rem 1rem}
.side nav{flex-direction:row;flex-wrap:wrap;gap:.25rem 1rem}
.side nav a{padding:.5rem 0;border-left:0;border-bottom:3px solid transparent}
.side nav a.aktif{border-bottom-color:var(--glow)}
.data div,.skill li,.kontak li{grid-template-columns:1fr;gap:.25rem}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
