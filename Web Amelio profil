<script>
document.getElementById('tahun').textContent = new Date().getFullYear();
const tautan = Array.from(document.querySelectorAll('.side nav a'));
const pengamat = new IntersectionObserver((daftar) => {
  daftar.forEach((item) => {
    if (!item.isIntersecting) return;
    tautan.forEach((a) => {
      const aktif = a.hash === '#' + item.target.id;
      a.classList.toggle('aktif', aktif);
      if (aktif) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
    });
  });
}, { rootMargin: '-40% 0px -55% 0px' });
document.querySelectorAll('main section').forEach((s) => pengamat.observe(s));
</script>
